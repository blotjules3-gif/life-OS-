+        XCTAssertEqual(store.load()?.running, false)
+
+        keeper.discard()
+        XCTAssertNil(store.load(), "abandonner efface le snapshot")
+        XCTAssertEqual(e.phase, .idle)
+        XCTAssertFalse(keeper.hasActiveSession)
+    }
